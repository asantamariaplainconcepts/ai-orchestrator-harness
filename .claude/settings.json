{
  "permissions": {
    "allow": [
      "Bash(.aio/aio done:*)",
      "Bash(.aio/aio issue:*)",
      "Bash(.aio/aio pr:*)",
      "Bash(git:*)",
      "Bash(dotnet:*)",
      "Bash(aspire:*)",
      "Bash(pnpm:*)",
      "Bash(node:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh repo view:*)"
    ],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git push --no-verify:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-tool-use"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-tool-use"
          }
        ]
      }
    ]
  }
}
