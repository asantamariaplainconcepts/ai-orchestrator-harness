<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AiOrchestrator.Modules.Loop.FunctionalTests</RootNamespace>
    <AssemblyName>AiOrchestrator.Modules.Loop.FunctionalTests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiOrchestrator.SharedFunctionalTests\AiOrchestrator.SharedFunctionalTests.csproj" />
    <ProjectReference Include="..\..\modules\Loop\AiOrchestrator.Modules.Loop\AiOrchestrator.Modules.Loop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repository's own loop, read where it lives so the tests check the file people edit
         rather than a copy of it. -->
    <None Include="..\..\..\.aio\loop.yaml" Link="Fixtures\loop.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
