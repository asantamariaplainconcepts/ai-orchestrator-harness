<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'"
      >true</ContinuousIntegrationBuild>
    <Version>0.3.12</Version>
  </PropertyGroup>

  <!-- Auto-attach the module boundary analyzers to every `.Modules.*` implementation
       project (not test projects, which also match `.Modules.` in their name). -->
  <ItemGroup Condition="$(MSBuildProjectName.Contains('.Modules.')) AND !$(MSBuildProjectName.EndsWith('Tests'))">
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)shared\AiOrchestrator.ArchitectureAnalyzers\AiOrchestrator.ArchitectureAnalyzers.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <!-- Every test project starts without the AIO_ variables of the process that runs it (#762). -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)tests\InheritedEnvironment.cs" Link="InheritedEnvironment.cs" />
  </ItemGroup>
</Project>
