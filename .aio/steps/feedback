#!/usr/bin/env node
// Managed by aio. Install harness overwrites it.
// Report a fault in a harness step to whoever maintains it, the way Expo's skills ask for feedback:
// one issue per (step, subject), labelled harness-feedback, so the tenth agent that trips on the same
// instruction adds a comment to the first one's issue instead of a note nobody reads twice. Answers
// one JSON line, {issue, created, why}; exit 0 when it landed, 1 when it did not.
//
//   .aio/steps/feedback --about <command or skill> --subject "<the instruction, not the moment>" \
//     --note "<what it said versus what was true>" [--issue <n>] [--eval]
//
// - Only for something specific and actionable about the step itself: a missing prerequisite, an
//   instruction that did not match reality, a workaround it forced. A failing test is the change's,
//   not the harness's.
// - --subject names the instruction ("implement step 7: the gate path"), so the same fault finds the
//   same issue. The title is "[<about>] <subject>"; an open issue with exactly that title is reused.
// - --eval: an agent failed at this step repeatedly, or the person had to take over. The issue also
//   gets the label eval-candidate, and its body asks for the test or spec scenario that would have
//   caught it — the case to keep, not only the complaint.
// - --issue: the issue being worked. The feedback names it, and it is recorded in that issue's
//   aio:state comment, so the change's retro still offers it as "what didn't work".
// - Where it goes: `feedback.repository` (owner/name) in .aio/config.json, or this repository
//   when that is unset. A repository that adopted the harness can point it at the harness's own
//   upstream on purpose; the default keeps a team's notes in its own repository.
// - Nothing retries. When gh refuses, the answer says UNPUBLISHED with gh's reason and the report.

const { execFileSync } = require('node:child_process');
process.env.LC_ALL = 'C'; // git's sentences in English whatever the machine's language (#762)
const { readFileSync, realpathSync } = require('node:fs');
const path = require('node:path');

const say = (issue, created, why, code) => {
  process.stdout.write(`${JSON.stringify({ issue, created, why })}\n`);
  process.exit(code);
};

const gh = (args) =>
  execFileSync('gh', args, {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'pipe'],
    env: { ...process.env, GH_PAGER: 'cat', GH_PROMPT_DISABLED: '1' },
  });
const git = (args) => {
  try {
    return execFileSync('git', args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
  } catch {
    return '';
  }
};
const reason = (error) => String(error.stderr || error.message).trim().split('\n')[0];

function parse(argv) {
  const out = { eval: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--about') out.about = argv[++i];
    else if (a === '--subject') out.subject = argv[++i];
    else if (a === '--note') out.note = argv[++i];
    else if (a === '--issue') out.issue = argv[++i];
    else if (a === '--eval') out.eval = true;
    else say(null, false, `feedback: unknown argument ${a}`, 1);
  }
  return out;
}

async function main() {
  const args = parse(process.argv.slice(2));
  if (!args.about || !args.subject || !args.note) {
    say(null, false, 'feedback: --about, --subject and --note are all required', 1);
  }
  if (args.issue && !/^\d+$/.test(args.issue)) say(null, false, 'feedback: --issue takes an issue number', 1);

  const root = git(['rev-parse', '--show-toplevel']) || process.cwd();
  let repository = null;
  try {
    const text = readFileSync(path.join(root, '.aio', 'config.json'), 'utf8');
    repository = JSON.parse(text.split('\n').filter((line) => !line.trim().startsWith('//')).join('\n'))?.feedback?.repository || null;
  } catch {
    // No config, or none of it about feedback: this repository.
  }
  const where = repository ? ['-R', repository] : [];

  const title = `[${args.about}] ${args.subject}`;
  const here = git(['remote', 'get-url', 'origin']).replace(/^.*github\.com[:/]/, '').replace(/\.git$/, '');
  const worked = args.issue ? (repository && here ? `${here}#${args.issue}` : `#${args.issue}`) : null;
  const sha = git(['rev-parse', '--short', 'HEAD']) || 'unknown';
  const report = [
    args.note,
    '',
    `- Step: \`${args.about}\``,
    worked ? `- Found working on ${worked}, at \`${sha}\`` : `- At \`${sha}\``,
  ].join('\n');

  let number;
  let created = false;
  try {
    const labels = ['harness-feedback', ...(args.eval ? ['eval-candidate'] : [])];
    for (const label of labels) {
      try {
        gh(['label', 'create', label, ...where, '--color', label === 'eval-candidate' ? 'b60205' : 'fbca04']);
      } catch {
        // Already there.
      }
    }

    const open = JSON.parse(
      gh(['issue', 'list', ...where, '--label', 'harness-feedback', '--state', 'open', '--limit', '200', '--json', 'number,title']),
    );
    number = open.find((candidate) => candidate.title === title)?.number;

    if (number) {
      gh(['issue', 'comment', String(number), ...where, '--body', report]);
      if (args.eval) gh(['issue', 'edit', String(number), ...where, '--add-label', 'eval-candidate']);
    } else {
      const body = args.eval
        ? `${report}\n\nAn agent failed here repeatedly, or a person had to take over. Before fixing the step, ` +
          'write down the case: the test or the spec scenario that would have caught it.'
        : report;
      const url = gh(['issue', 'create', ...where, '--title', title, '--body', body, ...labels.flatMap((l) => ['--label', l])]).trim();
      number = Number(url.split('/').pop());
      created = true;
    }
  } catch (error) {
    say(null, false, `UNPUBLISHED: ${reason(error)} — ${title}: ${args.note}`, 1);
  }

  const reference = repository ? `${repository}#${number}` : `#${number}`;

  // The worked issue keeps a pointer, so its retro still sees what went wrong while it was worked.
  if (args.issue) {
    try {
      const self = realpathSync(__filename);
      const { readState, writeState } = await import(
        path.join(path.dirname(self), '..', 'lib', 'issue-state.mjs')
      );
      const { id, state } = readState(args.issue);
      state.feedback = [...(state.feedback ?? []), { at: new Date().toISOString(), about: args.about, subject: args.subject, issue: reference }];
      writeState(args.issue, id, state);
    } catch (error) {
      say(reference, created, `Reported in ${reference}, but #${args.issue}'s aio:state comment was not updated: ${reason(error)}`, 0);
    }
  }

  say(reference, created, `${created ? 'Opened' : 'Added to'} ${reference}: ${title}`, 0);
}

main();
